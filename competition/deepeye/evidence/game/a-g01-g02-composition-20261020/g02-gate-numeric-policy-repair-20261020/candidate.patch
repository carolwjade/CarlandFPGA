+			if state.error != "": return
+			_space(text, state)
+			if state.at >= text.length(): state.error = "布局文件 JSON 对象未结束"; return
+			if text[state.at] == "}": state.at += 1; return
+			if text[state.at] != ",": state.error = "布局文件 JSON 对象分隔无效"; return
+			state.at += 1; _space(text, state)
