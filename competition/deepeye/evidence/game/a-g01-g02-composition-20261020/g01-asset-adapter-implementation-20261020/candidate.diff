+	var first = presenter.obstacle_node(doc.obstacles[0].object_id).find_children("*","MeshInstance3D",true,false)[0]
+	var second = presenter.obstacle_node(doc.obstacles[5].object_id).find_children("*","MeshInstance3D",true,false)[0]
+	_check(first.mesh != second.mesh and first.material_override != second.material_override, "independent same-kind objects own independent mesh/material resources")
+	var ids := []
+	var mesh_ids := []
+	var triangles := 0
+	var mesh_count := 0
+	for obstacle in doc.obstacles:
+		var node = presenter.obstacle_node(obstacle.object_id)
+		ids.append(node.get_instance_id())
