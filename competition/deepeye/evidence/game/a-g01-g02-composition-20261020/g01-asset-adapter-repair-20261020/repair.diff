+func _test_fallback_parent(scene) -> void:
+	var doc = scene.document
+	scene._focus_point = Vector3.ZERO
+	scene._distance = 52.0
+	scene.apply_camera()
+	doc.add_obstacle("water",Vector3(2,3,4))
+	var id: int = doc.obstacles[0].object_id
+	# Force the real viewer's retained fallback path without changing B's factory.
+	scene._asset_presenter._remove(id)
+	scene._asset_presenter._failed_kinds[id] = "water"
+	doc.update_obstacle(id,{"size":Vector3(6,4,2),"rotation_deg":Vector3(17,31,-9)})
+	var basis := Basis.from_euler(Vector3(.2,.5,-.1)) * Basis.from_scale(Vector3(1.8,.7,1.2))
+	scene._world.transform = Transform3D(basis,Vector3(7,2,-4))
+	scene._sync_obstacles()
+	var fallback: MeshInstance3D = scene._fallback_obstacles[id]
+	var bounds := AABB(fallback.global_transform*Vector3(-3,-2,-1),Vector3.ZERO)
+	for x in [-3.0,3.0]:
+		for y in [-2.0,2.0]:
+			for z in [-1.0,1.0]:
+				bounds = bounds.expand(fallback.global_transform*Vector3(x,y,z))
+	var expected := Vector3(bounds.get_center().x,bounds.end.y+.7,bounds.get_center().z)
+	_check(scene._obstacle_labels[id].global_position.distance_to(expected)<.00002, "fallback label uses full affine transform including induced shear")
+	var screen: Vector2 = scene._camera.unproject_position(fallback.global_position)
+	_check(scene._pick_object(screen)==id, "fallback pick hits displayed center under rotated nonuniform parent")
+	scene._world.transform = Transform3D.IDENTITY
+	scene._sync_obstacles()
+	_check(scene._pick_object(scene._camera.unproject_position(fallback.global_position))==id, "fallback identity-parent picking retained")
+	# The farther fallback must not beat a closer real asset by changing t units.
+	doc.update_obstacle(id,{"position":Vector3.ZERO,"rotation_deg":Vector3.ZERO,"size":Vector3(8,1,9)})
+	doc.add_obstacle("fault",Vector3(0,0,6))
+	var near_id: int = doc.obstacles[1].object_id
+	doc.update_obstacle(near_id,{"size":Vector3(8,1,3)})
+	var parent := Transform3D(Basis(Quaternion(Vector3.UP,.3))*Basis.from_scale(Vector3(2,.7,3)),Vector3(7,2,-4))
+	scene._world.transform = parent
+	scene._sync_obstacles()
+	scene._camera.global_position = parent*Vector3(0,0,20)
+	scene._camera.look_at(parent*Vector3.ZERO,Vector3.UP)
+	var center_screen: Vector2 = scene._camera.unproject_position(parent*Vector3.ZERO)
+	_check(scene._pick_object(center_screen)==near_id, "fallback and real asset compare the same world ray t under anisotropic parent")
+	scene._world.transform = Transform3D.IDENTITY
+	scene.apply_camera()
