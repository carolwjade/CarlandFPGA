+func _test_validation_failures() -> void:
+	var presenter = load("res://viewer/asset_presenter.gd").new()
+	var factory = load("res://world/asset_library.gd")
+	for value in [false, 1, [], {}]:
+		var asset: Node3D = factory.create_obstacle("water")
+		asset.set_meta("source_license",value)
+		_check(_rejected(presenter._validate_asset(asset)), "non-string license rejected explicitly: " + str(typeof(value)))
+		asset.free()
+	var wrong_version: Node3D = factory.create_drill()
+	wrong_version.set_meta("asset_contract_version",1.0)
+	_check(_rejected(presenter._validate_asset(wrong_version)), "floating contract version is not an integer schema version")
+	wrong_version.free()
+	for empty_mode in ["children","null_mesh","empty_mesh","nonfinite_mesh"]:
+		var asset: Node3D = factory.create_obstacle("water")
+		var visual: Node3D = asset.get_node("Visual")
+		for child in visual.get_children():
+			child.free()
+		if empty_mode != "children":
+			var mesh := MeshInstance3D.new()
+			if empty_mode != "null_mesh":
+				mesh.mesh = ArrayMesh.new()
+			if empty_mode == "nonfinite_mesh":
+				var arrays := []
+				arrays.resize(Mesh.ARRAY_MAX)
+				arrays[Mesh.ARRAY_VERTEX] = PackedVector3Array([Vector3(NAN,0,0),Vector3(1,0,0),Vector3(0,1,0)])
+				mesh.mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays)
+			visual.add_child(mesh)
+		_check(_rejected(presenter._validate_asset(asset)), "actual Visual geometry rejected: " + empty_mode)
+		asset.free()
+	_check(presenter.report().state == "degraded", "uninitialized presenter does not report ready")
